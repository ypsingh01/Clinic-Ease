# =============================================================================
# FREE TIER (Vercel + Render + Neon) — copy these first
# =============================================================================
# FREE_TIER=true relaxes Twilio / live Razorpay / captcha requirements.
NODE_ENV="production"
FREE_TIER="true"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
JWT_SECRET="replace-with-32-plus-char-random-secret"
JWT_EXPIRES_IN="12h"
PORT=4000
CLIENT_ORIGIN="https://your-app.vercel.app"

WHATSAPP_MODE="mock"
OTP_DEV_CODE="123456"
ALLOW_MOCK_PAY="true"
RECAPTCHA_MODE="stub"
RECAPTCHA_SECRET=""

HOLD_MINUTES=5
CLAIM_MINUTES=10
CANCEL_POLICY_HOURS=2

# Optional: Razorpay test keys instead of mock pay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_SMS_FROM=""

SENTRY_DSN=""
LOG_LEVEL="info"
SEED_DEMO_USERS="true"
# Free tier without Render Shell: set a secret, then open
#   https://YOUR-API.onrender.com/api/setup/seed?secret=YOUR_SECRET
SEED_SECRET="change-me-seed-secret"
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_NAME="Clinic Admin"
ADMIN_BOOTSTRAP_PHONE="+91 90000 00000"

# =============================================================================
# PAID PRODUCTION — set FREE_TIER=false (or remove) and fill live secrets
# =============================================================================
# FREE_TIER="false"
# WHATSAPP_MODE="live"
# OTP_DEV_CODE=""
# ALLOW_MOCK_PAY="false"
# RECAPTCHA_MODE="live"
# RECAPTCHA_SECRET="xxx"
# RAZORPAY_KEY_ID="rzp_live_xxx"
# RAZORPAY_KEY_SECRET="xxx"
# RAZORPAY_WEBHOOK_SECRET="xxx"
# TWILIO_ACCOUNT_SID="ACxxx"
# TWILIO_AUTH_TOKEN="xxx"
# TWILIO_WHATSAPP_FROM="whatsapp:+1..."
# TWILIO_SMS_FROM="+1..."
# SEED_DEMO_USERS="false"
# ADMIN_BOOTSTRAP_EMAIL="admin@yourclinic.com"
# ADMIN_BOOTSTRAP_PASSWORD="strong-password-12+"
