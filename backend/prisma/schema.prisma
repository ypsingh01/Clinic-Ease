generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         String // patient | doctor | admin
  whatsappLinked Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor       Doctor?
  dependents   Dependent[]
  appointments Appointment[] @relation("PatientAppointments")
  notifications Notification[]
  waitlist     WaitlistEntry[]
  otps         OtpCode[]
}

model Doctor {
  id                      String   @id // stable ids e.g. dr-mehta
  userId                  String?  @unique
  name                    String
  specialty               String
  initials                String
  bio                     String   @default("")
  photoUrl                String   @default("")
  consultationFeeInr      Int      @default(500)
  avgConsultationMinutes  Float    @default(5)
  hourlyCapacityOverride  Int?
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user           User?                 @relation(fields: [userId], references: [id])
  availability   DoctorAvailability[]
  leaves         DoctorLeave[]
  appointments   Appointment[]
  delays         QueueDelayOffset[]
  waitlist       WaitlistEntry[]
}

model DoctorAvailability {
  id             String  @id @default(cuid())
  doctorId       String
  dayOfWeek      Int // 0=Sun .. 6=Sat
  enabled        Boolean @default(true)
  startTime      String  @default("09:00")
  endTime        String  @default("17:00")
  breakStart     String  @default("")
  breakEnd       String  @default("")
  hourlyCapacity Int     @default(12)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
}

model DoctorLeave {
  id       String   @id @default(cuid())
  doctorId String
  date     String // YYYY-MM-DD
  reason   String  @default("")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
}

model Dependent {
  id            String   @id @default(cuid())
  patientUserId String
  name          String
  relation      String // parent | spouse | child
  dateOfBirth   String?
  gender        String?
  age           Int      @default(0)
  createdAt     DateTime @default(now())

  patient      User          @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Appointment {
  id                String    @id @default(cuid())
  patientId         String
  doctorId          String
  dependentId       String?
  date              String // YYYY-MM-DD
  hourBlockStart    String
  hourBlockEnd      String
  queuePosition     Int
  estimatedStart    String
  estimatedEnd      String
  actualStartTime   DateTime?
  actualEndTime     DateTime?
  durationMin       Int?
  status            String // held | booked | checked_in | in_progress | completed | cancelled | no_show
  intake            String    @default("")
  holdExpiresAt     DateTime?
  createdByAdmin    Boolean   @default(false)
  payAtClinic       Boolean   @default(false)
  reminder24Sent    Boolean   @default(false)
  reminder1Sent     Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  patient   User       @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor    Doctor     @relation(fields: [doctorId], references: [id])
  dependent Dependent? @relation(fields: [dependentId], references: [id])
  payment   Payment?

  @@index([doctorId, date, hourBlockStart])
  @@index([patientId, status])
  @@index([status, holdExpiresAt])
}

model Payment {
  id                 String   @id @default(cuid())
  appointmentId      String   @unique
  razorpayOrderId    String?
  razorpayPaymentId  String?  @unique
  amountInr          Int
  method             String // razorpay | clinic | comped
  status             String // pending | paid | refunded | failed
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // in_app | whatsapp
  kind      String // reminder | eta | confirm | waitlist | whatsapp | broadcast
  title     String
  message   String
  status    String   @default("sent") // pending | sent | failed | read
  read      Boolean  @default(false)
  sentAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model QueueDelayOffset {
  id           String   @id @default(cuid())
  doctorId     String
  date         String
  offsetMinutes Int     @default(0)
  reason       String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
}

model WaitlistEntry {
  id             String    @id @default(cuid())
  patientId      String
  doctorId       String
  date           String
  hourBlockStart String
  hourBlockEnd   String
  position       Int
  status         String // waiting | notified | claimed | expired
  offerExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient User   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, date, hourBlockStart, status])
}

model SymptomSpecialtyMap {
  id              String @id @default(cuid())
  symptomKeyword  String @unique
  specialty       String
  label           String @default("")
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String?
  phone     String
  code      String
  purpose   String // register | login | link
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose])
}

model Broadcast {
  id         String   @id @default(cuid())
  title      String
  body       String
  audience   String // all | patients | doctors
  sentAt     DateTime @default(now())
  delivered  Int      @default(0)
  failed     Int      @default(0)
  createdBy  String?
}

model AuditEvent {
  id        String   @id @default(cuid())
  kind      String
  ip        String?
  userId    String?
  meta      String   @default("{}")
  createdAt DateTime @default(now())
}
