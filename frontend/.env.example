# Free-tier / Vercel — point at your Render API URL (no trailing slash)
VITE_API_URL=https://clinic-ease.onrender.com
VITE_SOCKET_URL=https://clinic-ease.onrender.com
VITE_USE_MOCK_CLINIC=false
# true = show patient/doctor/admin demo shortcuts on login (free demo OK)
VITE_DEMO_LOGIN=true
# Leave empty when API uses RECAPTCHA_MODE=stub
VITE_RECAPTCHA_SITE_KEY=
# Optional Razorpay test key id (rzp_test_...); leave empty if ALLOW_MOCK_PAY=true on API
VITE_RAZORPAY_KEY_ID=
# Optional
VITE_SENTRY_DSN=
